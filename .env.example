# Supabase project URL (leave blank to run fully locally with seeded demo data)
VITE_SUPABASE_URL=

# Supabase anon (publishable) key
VITE_SUPABASE_ANON_KEY=

# Groq API key for AI features. Optional — every AI feature falls back to
# well-written canned responses when this is missing or a call fails.
VITE_GROQ_API_KEY=

# "true" uses real Supabase email OTP (rate-limited on the free tier).
# "false" (default) uses the built-in mock auth: the code is shown on screen,
# no network calls, no rate limits.
VITE_USE_REAL_AUTH=false
